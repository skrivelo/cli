{
  "name": "kursiva",
  "version": "0.1.2",
  "description": "Command-line client for the Kursiva render API — turn Markdown into print-grade PDFs from any shell.",
  "type": "module",
  "bin": {
    "kursiva": "dist/index.js"
  },
  "files": [
    "dist",
    "contract",
    "SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kursiva-cli/kursiva.git"
  },
  "homepage": "https://github.com/kursiva-cli/kursiva#readme",
  "bugs": {
    "url": "https://github.com/kursiva-cli/kursiva/issues"
  },
  "keywords": [
    "pdf",
    "markdown",
    "cli",
    "documents",
    "template",
    "render"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "hygiene": "bash scripts/hygiene-audit.sh",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.7.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^4.0.15",
    "yaml": "^2.6.0"
  }
}
